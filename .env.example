# One local credential file for SubLLM consumers in this workspace.
# Keep the real .env at mode 0600 and never commit it.
# Strategies (credential → provider → models): see docs/credential-strategies.md

# Z.AI Coding Plan: {API Key ID}.{signature secret} → glm-5.2
ZAI_API_KEY=YOUR_API_KEY_ID.YOUR_SIGNATURE_SECRET

# OpenRouter → glm-5.2 and route extras (grok / gemini-flash / deepseek / qwen).
# Never used for Cursor Sol.
OPENROUTER_API_KEY=

# Cursor SDK (@cursor/sdk / cursor-sdk) → gpt-5.6-sol (and Cursor peers).
CURSOR_API_KEY=

# Optional pre-request fallback chain. Empty uses the default:
# cursor,zai,openrouter when CURSOR_API_KEY is set; otherwise zai,openrouter.
# Known ids: cursor, zai, openrouter. Unknown names fail closed.
# Leave empty so subllm.toml priorities control resolve() (cursor priority 0).
# An explicit list such as openrouter,zai reorders candidates and must keep
# route priority_offset values collision-free with provider indices.
SUBLLM_PROVIDER_ORDER=

# One local credential file for SubLLM consumers in this workspace.
# Keep the real .env at mode 0600 and never commit it.

# Z.AI keys use: {API Key ID}.{signature secret}
ZAI_API_KEY=YOUR_API_KEY_ID.YOUR_SIGNATURE_SECRET

# Fallback provider used by routes declared in src/subllm/policy.py.
OPENROUTER_API_KEY=

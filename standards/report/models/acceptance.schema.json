{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/report-acceptance/v1",
  "title": "Scoped acceptance claims, never authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "authority",
    "report_id",
    "created",
    "updated",
    "review_after",
    "subjects",
    "evidence",
    "answers",
    "stages"
  ],
  "properties": {
    "schema": {
      "const": "wellmanifest.report/acceptance/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "authority": {
      "const": "none"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "source_revision",
          "artifact_sha256",
          "bindings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "instance",
              "process",
              "scenario"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                "maxLength": 160
              },
              "instance": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "process": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scenario": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "id",
                "revision",
                "sha256"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "config",
                    "policy",
                    "schema",
                    "model",
                    "dependency"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "minItems": 0,
            "maxItems": 256
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject_id",
          "subject_sha256",
          "reference",
          "sha256",
          "producer",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reference": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^(?:(?:artifact|receipt):sha256:[a-f0-9]{64}|repo://[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[a-f0-9]{40}/[^\\s?#]+)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "result"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "result": {
                "enum": [
                  "MATCH",
                  "MISMATCH",
                  "NOT_CHECKED"
                ]
              }
            }
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "status",
          "claim",
          "subject_id",
          "applicability",
          "observation",
          "evidence_ids",
          "limits",
          "nextAction"
        ],
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{2,6}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "N/A"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reason",
              "activation_condition"
            ],
            "properties": {
              "state": {
                "enum": [
                  "APPLICABLE",
                  "NOT_APPLICABLE"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "activation_condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "environment",
              "architecture",
              "method",
              "execution",
              "result"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "architecture": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "execution": {
                "enum": [
                  "PERFORMED",
                  "NOT_RUN"
                ]
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "untested",
              "missing_data",
              "valid_through",
              "invalidate_on"
            ],
            "properties": {
              "untested": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 0,
                "maxItems": 256
              },
              "missing_data": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 0,
                "maxItems": 256
              },
              "valid_through": {
                "type": "string",
                "format": "date"
              },
              "invalidate_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "minItems": 1,
                "maxItems": 256
              }
            }
          },
          "nextAction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "owner",
              "ticket_ref",
              "proposal"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                "maxLength": 160
              },
              "ticket_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "proposal": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "requires",
          "depends_on",
          "eligibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "phase": {
            "enum": [
              "plan",
              "twin",
              "queue",
              "execution",
              "pr",
              "review",
              "merge",
              "release",
              "deployment"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{2,6}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,79}$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "eligibility": {
            "enum": [
              "ELIGIBLE",
              "BLOCKED"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "description": "Separate acceptance payload correlated to a canonical report by report_id, not a replacement for Docs placement or protected receipts. Subject SHA-256 uses sorted-key JSON, ASCII escapes and no whitespace, encoded as UTF-8. Eligibility is date-granular and advisory.",
  "examples": [
    {
      "schema": "wellmanifest.report/acceptance/v1",
      "id": "synthetic-acceptance",
      "version": 1,
      "authority": "none",
      "report_id": "example-report",
      "created": "2026-09-14",
      "updated": "2026-09-14",
      "review_after": "2026-09-21",
      "subjects": [
        {
          "id": "candidate",
          "scope": {
            "repository": "wellmanifest/report",
            "instance": null,
            "process": null,
            "scenario": "Synthetic fixture, not deployment evidence"
          },
          "source_revision": "ea38b85f75cd3b5109eeb22393e8201b3e8299c6",
          "artifact_sha256": null,
          "bindings": []
        }
      ],
      "evidence": [],
      "answers": [
        {
          "questionId": "V-01",
          "status": "UNKNOWN",
          "claim": "No deployed artifact has been observed.",
          "subject_id": "candidate",
          "applicability": {
            "state": "APPLICABLE",
            "reason": "This fixture asks for deployment evidence.",
            "activation_condition": null
          },
          "observation": {
            "at": "2026-09-14T00:00:00Z",
            "environment": "synthetic fixture",
            "architecture": "not observed",
            "method": "record missing observation",
            "execution": "NOT_RUN",
            "result": "No deployment or canary result supplied."
          },
          "evidence_ids": [],
          "limits": {
            "untested": [
              "All real deployments"
            ],
            "missing_data": [
              "Deployment receipt"
            ],
            "valid_through": "2026-09-21",
            "invalidate_on": [
              "Any subject, scope, policy, model, data or measurement condition change"
            ]
          },
          "nextAction": {
            "description": "Obtain an independently verified receipt in the owning project.",
            "owner": "wellmanifest/report",
            "ticket_ref": null,
            "proposal": "Scoped consumer acceptance; do not allocate automatically."
          }
        }
      ],
      "stages": [
        {
          "id": "deployment",
          "phase": "deployment",
          "requires": [
            "V-01"
          ],
          "depends_on": [],
          "eligibility": "BLOCKED"
        }
      ]
    }
  ]
}

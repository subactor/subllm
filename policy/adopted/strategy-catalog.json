{
  "schema": "subactor.llm/credential-strategy-catalog/v1",
  "strategies": [
    {
      "id": "cursor",
      "credentialEnv": "CURSOR_API_KEY",
      "provider": "cursor",
      "transport": "cursor-sdk",
      "apiBase": "https://api.cursor.com",
      "defaultModel": "gpt-5.6-sol",
      "allowedModels": ["gpt-5.6-sol", "grok-4.6"],
      "fallbackOrder": ["gpt-5.6-sol", "grok-4.6"],
      "notes": "Cursor SDK / @cursor/sdk. Prefer Sol then Grok 4.6. Never OpenRouter wire ids."
    },
    {
      "id": "zai",
      "credentialEnv": "ZAI_API_KEY",
      "provider": "zai",
      "transport": "openai-compatible",
      "apiBase": "https://api.z.ai/api/coding/paas/v4",
      "defaultModel": "glm-5.2",
      "allowedModels": ["glm-5.2"],
      "notes": "Z.AI Coding Plan LiteLLM path."
    },
    {
      "id": "openrouter",
      "credentialEnv": "OPENROUTER_API_KEY",
      "provider": "openrouter",
      "transport": "openai-compatible",
      "apiBase": "https://openrouter.ai/api/v1",
      "defaultModel": "glm-5.3-flash",
      "allowedModels": [
        "glm-5.2",
        "glm-5.3",
        "glm-5.3-flash",
        "grok-4.5",
        "gemini-3.6-flash",
        "deepseek-v4-pro",
        "qwen3.7-plus"
      ],
      "forbiddenModels": ["gpt-5.6-sol"],
      "notes": "OpenRouter models only. Cursor Sol must not appear as openai/gpt-5.6-sol."
    },
    {
      "id": "agy",
      "credentialEnv": "GEMINI_API_KEY",
      "provider": "agy",
      "transport": "gemini-sdk",
      "apiBase": "https://generativelanguage.googleapis.com/v1beta",
      "defaultModel": "gemini-2.5-flash",
      "allowedModels": ["gemini-2.5-flash", "gemini-2.5-pro"],
      "notes": "Google Antigravity / Gemini CLI path."
    },
    {
      "id": "codex",
      "credentialEnv": "OPENAI_API_KEY",
      "provider": "codex",
      "transport": "openai-compatible",
      "apiBase": "https://api.openai.com/v1",
      "defaultModel": "gpt-5.5",
      "allowedModels": ["gpt-5.5"],
      "notes": "OpenAI Codex CLI path."
    },
    {
      "id": "claude",
      "credentialEnv": "ANTHROPIC_API_KEY",
      "provider": "claude",
      "transport": "anthropic",
      "apiBase": "https://api.anthropic.com/v1",
      "defaultModel": "claude-3.7-sonnet",
      "allowedModels": ["claude-3.7-sonnet"],
      "notes": "Claude Code CLI / Anthropic path."
    },
    {
      "id": "ollama",
      "credentialEnv": "OLLAMA_API_KEY",
      "provider": "ollama",
      "transport": "openai-compatible",
      "apiBase": "http://127.0.0.1:11434/v1",
      "defaultModel": "qwen2.5-coder",
      "allowedModels": ["qwen2.5-coder"],
      "notes": "Ollama local model path."
    }
  ],
  "defaultProviderOrder": {
    "withCursorKey": ["cursor", "zai", "openrouter"],
    "withoutCursorKey": ["zai", "openrouter"]
  },
  "providerOrderEnv": "SUBLLM_PROVIDER_ORDER",
  "failClosed": true
}

# Portable SubLLM credential-strategy constants (no secrets).
# Runtime keys live in a separately governed .env / vault; Env DSL only
# names the env vars, providers, default models and allowlists.
ENV_DSL_VERSION=1
ENV_DSL_NAMESPACE=SUBACTOR_SUBLLM
ENV_DSL_ENVIRONMENT=BASE
STRATEGY_CURSOR=CURSOR
STRATEGY_ZAI=ZAI
STRATEGY_OPENROUTER=OPENROUTER
CURSOR_KEY_ENV_NAME=CURSOR_API_KEY
ZAI_KEY_ENV_NAME=ZAI_API_KEY
OPENROUTER_KEY_ENV_NAME=OPENROUTER_API_KEY
CURSOR_PROVIDER=cursor
ZAI_PROVIDER=zai
OPENROUTER_PROVIDER=openrouter
CURSOR_TRANSPORT=cursor-sdk
ZAI_TRANSPORT=openai-compatible
OPENROUTER_TRANSPORT=openai-compatible
CURSOR_API_BASE=https://api.cursor.com
ZAI_API_BASE=https://api.z.ai/api/coding/paas/v4
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CURSOR_DEFAULT_MODEL=gpt-5.6-sol
ZAI_DEFAULT_MODEL=glm-5.2
OPENROUTER_DEFAULT_MODEL=glm-5.2
CURSOR_ALLOWED_MODELS=gpt-5.6-sol
ZAI_ALLOWED_MODELS=glm-5.2
OPENROUTER_ALLOWED_MODELS=glm-5.2,grok-4.5,gemini-3.6-flash,deepseek-v4-pro,qwen3.7-plus
CURSOR_ONLY_MODELS=gpt-5.6-sol
DEFAULT_ORDER_WITH_CURSOR=cursor,zai,openrouter
DEFAULT_ORDER_WITHOUT_CURSOR=zai,openrouter
PROVIDER_ORDER_ENV_NAME=SUBLLM_PROVIDER_ORDER
CURSOR_STRATEGY_CONDITION=@CURSOR_PROVIDER==:cursor
ZAI_STRATEGY_CONDITION=@ZAI_PROVIDER==:zai
OPENROUTER_STRATEGY_CONDITION=@OPENROUTER_PROVIDER==:openrouter
SOL_NOT_ON_OPENROUTER_CONDITION=@CURSOR_ONLY_MODELS==@CURSOR_DEFAULT_MODEL&&@OPENROUTER_DEFAULT_MODEL!=@CURSOR_DEFAULT_MODEL
